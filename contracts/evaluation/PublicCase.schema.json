{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "external_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "system",
            "tool",
            "service"
          ],
          "title": "Role",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "external_id",
        "role"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_evidence_items": {
          "default": 12,
          "maximum": 40,
          "minimum": 1,
          "title": "Max Evidence Items",
          "type": "integer"
        },
        "max_context_tokens": {
          "default": 8000,
          "maximum": 32000,
          "minimum": 64,
          "title": "Max Context Tokens",
          "type": "integer"
        },
        "recent_limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Recent Limit",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "ContentBlock": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "tool_result"
          ],
          "title": "Type",
          "type": "string"
        },
        "text": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        }
      },
      "required": [
        "block_id",
        "type",
        "text"
      ],
      "title": "ContentBlock",
      "type": "object"
    },
    "DeletionTarget": {
      "additionalProperties": false,
      "properties": {
        "source_stream_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Stream Id",
          "type": "string"
        },
        "source_event_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Event Id",
          "type": "string"
        },
        "entity_type": {
          "enum": [
            "message",
            "document"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "target_revision": {
          "default": null,
          "title": "Target Revision",
          "type": "null"
        }
      },
      "required": [
        "source_stream_id",
        "source_event_id",
        "entity_type"
      ],
      "title": "DeletionTarget",
      "type": "object"
    },
    "FixtureEvent": {
      "additionalProperties": false,
      "properties": {
        "fixture_event_id": {
          "minLength": 1,
          "title": "Fixture Event Id",
          "type": "string"
        },
        "episode_id": {
          "title": "Episode Id",
          "type": "string"
        },
        "replay_seq": {
          "minimum": 1,
          "title": "Replay Seq",
          "type": "integer"
        },
        "fixture_received_at": {
          "format": "date-time",
          "title": "Fixture Received At",
          "type": "string"
        },
        "auth_subject_ref": {
          "title": "Auth Subject Ref",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/MemoryEvent"
        }
      },
      "required": [
        "fixture_event_id",
        "episode_id",
        "replay_seq",
        "fixture_received_at",
        "auth_subject_ref",
        "payload"
      ],
      "title": "FixtureEvent",
      "type": "object"
    },
    "MemoryEvent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.1",
          "title": "Schema Version",
          "type": "string"
        },
        "delivery_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Delivery Id",
          "type": "string"
        },
        "project_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "connector_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Connector Id",
          "type": "string"
        },
        "middleware_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Middleware Id",
          "type": "string"
        },
        "origin_namespace": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Origin Namespace",
          "type": "string"
        },
        "source_stream_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Stream Id",
          "type": "string"
        },
        "source_event_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Event Id",
          "type": "string"
        },
        "source_revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "source_sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sequence"
        },
        "expected_previous_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Previous Revision"
        },
        "event_type": {
          "enum": [
            "message.upsert",
            "message.delete",
            "document.upsert",
            "document.delete",
            "tool.result"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "conversation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Id"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "occurred_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Occurred At"
        },
        "source_updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Updated At"
        },
        "source_timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Timezone"
        },
        "time_precision": {
          "default": "unknown",
          "enum": [
            "millisecond",
            "second",
            "minute",
            "day",
            "unknown"
          ],
          "title": "Time Precision",
          "type": "string"
        },
        "content": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContentBlock"
          },
          "maxItems": 128,
          "title": "Content",
          "type": "array"
        },
        "deletion_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeletionTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reply_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reply To"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "causation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "backfill": {
          "default": false,
          "title": "Backfill",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "mapping_revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Mapping Revision",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "delivery_id",
        "project_id",
        "connector_id",
        "middleware_id",
        "origin_namespace",
        "source_stream_id",
        "source_event_id",
        "source_revision",
        "event_type",
        "actor",
        "occurred_at",
        "mapping_revision"
      ],
      "title": "MemoryEvent",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "episode_id": {
          "title": "Episode Id",
          "type": "string"
        },
        "checkpoint_id": {
          "title": "Checkpoint Id",
          "type": "string"
        },
        "replay_seq": {
          "minimum": 1,
          "title": "Replay Seq",
          "type": "integer"
        },
        "query_at": {
          "format": "date-time",
          "title": "Query At",
          "type": "string"
        },
        "cutoff_replay_seq": {
          "minimum": 0,
          "title": "Cutoff Replay Seq",
          "type": "integer"
        },
        "knowledge_cutoff_at": {
          "format": "date-time",
          "title": "Knowledge Cutoff At",
          "type": "string"
        },
        "target_valid_at": {
          "format": "date-time",
          "title": "Target Valid At",
          "type": "string"
        },
        "time_mode": {
          "default": "current",
          "enum": [
            "current",
            "as_known_at",
            "as_of_event"
          ],
          "title": "Time Mode",
          "type": "string"
        },
        "auth_subject_ref": {
          "title": "Auth Subject Ref",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "conversation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Id"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "required_capabilities": {
          "default": [
            "raw"
          ],
          "items": {
            "type": "string"
          },
          "title": "Required Capabilities",
          "type": "array"
        },
        "consistency_mode": {
          "default": "best_effort",
          "enum": [
            "best_effort",
            "at_least"
          ],
          "title": "Consistency Mode",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "episode_id",
        "checkpoint_id",
        "replay_seq",
        "query_at",
        "cutoff_replay_seq",
        "knowledge_cutoff_at",
        "target_valid_at",
        "auth_subject_ref",
        "project_id",
        "question"
      ],
      "title": "Question",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "connector_id": {
          "title": "Connector Id",
          "type": "string"
        },
        "middleware_id": {
          "title": "Middleware Id",
          "type": "string"
        },
        "origin_namespace": {
          "title": "Origin Namespace",
          "type": "string"
        },
        "actor_ids": {
          "items": {
            "type": "string"
          },
          "title": "Actor Ids",
          "type": "array"
        },
        "permissions": {
          "default": [
            "write",
            "read"
          ],
          "items": {
            "type": "string"
          },
          "title": "Permissions",
          "type": "array"
        }
      },
      "required": [
        "tenant_id",
        "project_id",
        "connector_id",
        "middleware_id",
        "origin_namespace",
        "actor_ids"
      ],
      "title": "Scope",
      "type": "object"
    },
    "Variant": {
      "additionalProperties": false,
      "properties": {
        "variant_id": {
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Variant Id",
          "type": "string"
        },
        "index_enabled": {
          "default": true,
          "title": "Index Enabled",
          "type": "boolean"
        },
        "worker_delay_ms": {
          "default": 0,
          "maximum": 3600000,
          "minimum": 0,
          "title": "Worker Delay Ms",
          "type": "integer"
        }
      },
      "required": [
        "variant_id"
      ],
      "title": "Variant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The entire allowlisted stdin of the SUT process; no paths, Gold or tags.",
  "properties": {
    "subjects": {
      "additionalProperties": {
        "$ref": "#/$defs/Scope"
      },
      "title": "Subjects",
      "type": "object"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/FixtureEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "question": {
      "$ref": "#/$defs/Question"
    },
    "variant": {
      "$ref": "#/$defs/Variant"
    },
    "mode": {
      "enum": [
        "capability",
        "operational"
      ],
      "title": "Mode",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "query_deadline_ms": {
      "title": "Query Deadline Ms",
      "type": "integer"
    }
  },
  "required": [
    "subjects",
    "events",
    "question",
    "variant",
    "mode",
    "budget",
    "query_deadline_ms"
  ],
  "title": "PublicCase",
  "type": "object"
}
